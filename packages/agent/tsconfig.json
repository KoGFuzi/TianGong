{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"lib": ["ESNext", "DOM"],
		"paths": {
			"@onepanda-tiangongsec/tg-ai": ["../ai/src/index.ts"],
			"@onepanda-tiangongsec/tg-ai/compat": ["../ai/src/compat.ts"],

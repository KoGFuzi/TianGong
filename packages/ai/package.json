{
  "name": "@onepanda-tiangongsec/tg-ai",
  "version": "2.0.0",
  "description": "Unified LLM API with automatic model discovery and provider configuration — Bun-native",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/compat.js",
    "./dist/images.js",
    "./dist/providers/images/register-builtins.js"
  ],
  "exports": {
    ".": {
      "bun": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./compat": {
      "bun": "./dist/compat.js",
      "types": "./dist/compat.d.ts"
    },
    "./providers/*": {
      "bun": "./dist/providers/*.js",
      "types": "./dist/providers/*.d.ts"
    },
    "./api/*": {
      "bun": "./dist/api/*.js",
      "types": "./dist/api/*.d.ts"
    },
    "./oauth": {
      "bun": "./dist/oauth.js",
      "types": "./dist/oauth.d.ts"
    },
    "./bedrock-provider": {
      "bun": "./dist/bedrock-provider.js",
      "types": "./dist/bedrock-provider.d.ts"
    },
    "./bun-oauth": {
      "bun": "./dist/bun-oauth.js",
      "types": "./dist/bun-oauth.d.ts"
    }
  },
  "bin": {
    "tiangong-sec": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "bun.lockb"
  ],
  "scripts": {
    "clean": "bun -e \"await Bun.$`rm -rf dist`\"",
    "generate-models": "bun scripts/generate-models.ts --strict",
    "hydrate-model-data": "bun scripts/generate-models.ts --strict --data-only",
    "generate-model-catalog": "bun scripts/generate-models.ts --strict --json-only --json-output ../../.artifacts/model-catalog",
    "generate-image-models": "bun scripts/generate-image-models.ts --strict",
    "check:model-data": "bun scripts/check-model-data.ts",
    "build": "bun run generate-models && bun run build:bun",
    "build:bun": "bun run check:model-data && bun build src/index.ts --target=bun --outdir=dist --sourcemap --no-splitting",
    "build:all": "bun run build:bun && bun run copy:data",
    "copy:data": "bun -e \"await Bun.$`rm -rf dist/providers/data && mkdir -p dist/providers && cp -r src/providers/data dist/providers/data`\"",
    "build:cli": "bun build src/cli.ts --target=bun --compile --minify --outfile=dist/tiangong-sec",
    "build:cli:all": "bun run build:cli && bun run build:cli:linux && bun run build:cli:darwin && bun run build:cli:win",
    "build:cli:linux": "bun build src/cli.ts --target=bun --compile --minify --outfile=dist/tiangong-sec-linux --target=x86_64-linux",
    "build:cli:darwin": "bun build src/cli.ts --target=bun --compile --minify --outfile=dist/tiangong-sec-darwin --target=aarch64-darwin",
    "build:cli:win": "bun build src/cli.ts --target=bun --compile --minify --outfile=dist/tiangong-sec-win.exe --target=x86_64-windows",
    "test": "bun test --isolate --timeout=15000 test/abort.test.ts test/empty.test.ts test/stream.test.ts test/text.test.ts test/validation.test.ts test/uuid.test.ts test/overflow.test.ts test/retry.test.ts test/sampling-options.test.ts test/reasoning-options.test.ts test/image-model-data.test.ts test/fireworks-models.test.ts test/oauth-device-code.test.ts test/anthropic-eager-tool-input-compat.test.ts",
    "test:all": "bun test --isolate --timeout=120000",
    "test:e2e": "bun run test:all",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:ci": "bun test --isolate --coverage --bail",
    "typecheck": "bunx tsc --noEmit",
    "typecheck:test": "bunx tsc -p tsconfig.test.json --noEmit --noCheck",
    "lint": "bunx biome check src/",
    "format": "bunx biome format --write src/",
    "prepublishOnly": "bun run clean && bun run build:all && bun run typecheck && bun run test:ci"
  },
  "dependencies": {
    "effect": "4.0.0-rc.111",
    "@anthropic-ai/sdk": "0.120.0",
    "@google/genai": "2.18.0",
    "openai": "7.5.0",
    "@aws-sdk/client-bedrock-runtime": "3.1048.0",
    "@smithy/node-http-handler": "4.7.3",
    "@smithy/types": "4.17.2",
    "partial-json": "0.1.7",
    "typebox": "1.3.7",
    "@onepanda-tiangongsec/tg-telemetry": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.0",
    "@napi-rs/canvas": "1.0.8",
    "@types/node": "26.3.0",
    "bun-types": "1.3.14"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "trustedDependencies": [
    "@napi-rs/canvas"
  ],
  "keywords": [
    "ai",
    "llm",
    "openai",
    "anthropic",
    "gemini",
    "bedrock",
    "unified",
    "api",
    "bun",
    "effect"
  ]
}

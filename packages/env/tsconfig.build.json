{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"paths": {
			"@OnePanda-TgSec/chord": ["../chord/dist/index.d.ts"],
			"@OnePanda-TgSec/chord/context": ["../chord/dist/context/index.d.ts"],
			"@OnePanda-TgSec/tg-gibraltar": ["../gibraltar/dist/index.d.ts"],
			"@OnePanda-TgSec/tg-gibraltar/*": ["../gibraltar/dist/*.d.ts", "../gibraltar/dist/*/index.d.ts"]

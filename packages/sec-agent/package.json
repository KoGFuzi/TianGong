{
	"name": "@OnePanda-TgSec/tg-sec-agent",
	"version": "2.0.1",
	"description": "TianGong coding agent CLI with read, bash, edit, write tools and session management",
	"type": "module",
	"tgConfig": {
		"name": "tg",
		"configDir": ".tiangong"
	},
	"bin": {
		"tg": "dist/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json",
		"./rpc-entry": {
			"types": "./dist/rpc-entry.d.ts",
			"import": "./dist/rpc-entry.js"
		}
	},
	"files": [
		"dist",
		"docs",
		"examples",
		"schemas",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json && bun run copy-assets",
		"copy-assets": "shx mkdir -p dist/modes/interactive/theme && shx cp src/modes/interactive/theme/*.json dist/modes/interactive/theme/ && shx mkdir -p dist/modes/interactive/assets && shx cp src/modes/interactive/assets/*.png dist/modes/interactive/assets/ && shx mkdir -p dist/core/export-html/vendor && shx cp src/core/export-html/template.html src/core/export-html/template.css src/core/export-html/template.js dist/core/export-html/ && shx cp src/core/export-html/vendor/*.js dist/core/export-html/vendor/",
		"generate:schemas": "node --import ./src/experimental/source-resolver.ts scripts/generate-schemas.ts",
		"generate:references": "node --import ./src/experimental/source-resolver.ts scripts/generate-references.ts",
		"test": "vitest --run",
		"prepublishOnly": "bun run clean && bun run build"
	},
	"dependencies": {
		"@OnePanda-TgSec/tg-agent-core": "^2.0.1",
		"@OnePanda-TgSec/tg-ai": "^2.0.1",
		"@OnePanda-TgSec/tg-tui": "^2.0.1",
		"@earendil-works/pi-codemode": "^1.3.0",
		"@earendil-works/pi-mcp": "^1.3.0",
		"@silvia-odwyer/photon-node": "0.3.4",
		"brace-expansion": "5.0.12",
		"chalk": "6.0.0",
		"cross-spawn": "7.0.6",
		"diff": "8.0.4",
		"grok-mermaid": "0.2.3",
		"highlight.js": "10.7.3",
		"hosted-git-info": "9.0.3",
		"ignore": "7.0.8",
		"jiti": "2.7.0",
		"minimatch": "10.2.6",
		"proper-lockfile": "4.1.2",
		"quickjs-wasi": "3.6.2",
		"semver": "7.8.5",
		"typebox": "1.3.27",
		"undici": "8.10.2",
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"@types/cross-spawn": "6.0.6",
		"@types/hosted-git-info": "3.0.5",
		"@types/node": "22.19.19",
		"@types/proper-lockfile": "4.1.4",
		"@types/semver": "7.7.1",
		"marked": "18.0.11",
		"shx": "0.4.0",
		"vitest": "4.1.11"
	},
	"keywords": [
		"coding-agent",
		"ai",
		"llm",
		"cli",
		"tui",
		"agent"
	],
	"author": "KoGFuzi",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/KoGFuzi/TianGong.git",
		"directory": "packages/sec-agent"
	},
	"engines": {
		"bun": ">=1.4.0",
		"node": ">=22.19.0"
	}
}

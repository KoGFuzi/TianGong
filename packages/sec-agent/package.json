{
	"name": "@OnePanda-TgSec/tg-sec-agent",
	"version": "2.0.1",
	"description": "TianGong security agent: gibraltar-native campaign runtime with action-tree delegation and sec-guard wiring",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"tg-sec": "./dist/cli/main.js",
		"tgsec": "./dist/tui/main.js"
	},
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "bun run clean && bun run build"
	},
	"keywords": [
		"security",
		"agent",
		"gibraltar",
		"redteam"
	],
	"author": "KoGFuzi",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/KoGFuzi/TianGong.git",
		"directory": "packages/sec-agent"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@earendil-works/pi-codemode": "^1.4.0",
		"@OnePanda-TgSec/chord": "^2.0.1",
		"@OnePanda-TgSec/tg-ai": "^2.0.1",
		"@OnePanda-TgSec/tg-gibraltar": "^2.0.1",
		"@OnePanda-TgSec/tg-sec-guard": "^2.0.1",
		"@OnePanda-TgSec/tg-telemetry": "^2.0.1",
		"@OnePanda-TgSec/tg-tui": "^2.0.1",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"shx": "0.4.0",
		"vitest": "4.1.11"
	}
}

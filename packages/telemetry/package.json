{
	"name": "@OnePanda-TgSec/tg-telemetry",
	"version": "2.0.1",
	"description": "Vendor-neutral telemetry contracts and typed schema utilities for TianGong",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "bun run clean && bun run build"
	},
	"keywords": [
		"telemetry",
		"tracing",
		"observability"
	],
	"author": "KoGFuzi",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/KoGFuzi/TianGong.git",
		"directory": "packages/telemetry"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"vitest": "4.1.11"
	}
}

{
  "name": "@onepanda-tiangongsec/tg-telemetry",
  "version": "2.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "bun": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
		"build": "bun run clean && bun build ./src/index.ts ./src/testing/index.ts --outdir ./dist --target bun --format esm && bunx tsc -p tsconfig.build.json",
    "test": "bun test",
    "prepublishOnly": "bun run clean && bun run build"
  },
  "keywords": [
    "telemetry",
    "tracing",
    "observability"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "dependencies": {
    "effect": "4.0.0-rc.111"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
